# 依存とキャッシュ
node_modules/

# 書き出した動画はGit管理しない
out/*
!out/.gitkeep

# 実写真はGit管理しない（ローカル/iCloud/Driveで管理）
public/photos/*
!public/photos/.gitkeep

# 実音源もGit管理しない。市販楽曲・私的音源を誤commitしない。
public/audio/*
!public/audio/.gitkeep

.DS_Store
*.log
exports/**/*.mp4
exports/**/*.webm
exports/**/*.mov
exports/**/*.png
exports/**/*.jpg
